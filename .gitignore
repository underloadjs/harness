# Dependencies - never commit these
node_modules/

# Build output
dist/
lib/

# Turbo cache
.turbo/

# Tooling caches
.eslintcache
*.tsbuildinfo

# Test coverage
coverage/

# Package-manager logs
yarn-debug.log*
yarn-error.log*
npm-debug.log*

# Local env / secrets
.env
.env.*
# Keep the placeholder template tracked so `cp .env.example .env` is discoverable.
!.env.example

# OS junk
.DS_Store
Thumbs.db

# Editor state
.idea/
.vscode/

# Dependencies - never commit these
node_modules/

# Build output
dist/
lib/
# Staging dir of the RETIRED declaration build: scripts/build-declarations.ts and
# scripts/fix-declaration-specifiers.ts are deleted and nothing writes .entries/ any
# more; the rule only keeps an old checkout's leftovers out of `git status`.
.entries/

# Turbo cache
.turbo/

# Tooling caches
.eslintcache
*.tsbuildinfo

# Test coverage
coverage/

# Package-manager logs
yarn-debug.log*
yarn-error.log*
npm-debug.log*

# Local env / secrets
.env
.env.*
# Keep the placeholder template tracked so `cp .env.example .env` is discoverable.
!.env.example

# OS junk
.DS_Store
Thumbs.db

# Editor state
.idea/
.vscode/

# Agent scratch space (see root AGENTS.md) - never commit
/Temp/

# Where the `download` tool saves fetched files when the harness runs with this
# directory as its working directory (tools/webdownload saves to
# .underload/downloads so glob/grep/read can reach the bytes). Runtime output,
# produced by the agent, never source.
.underload/

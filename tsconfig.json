{
    // Self-contained config (no `extends` outside the repo): this package is a
    // standalone GitHub repo (git@github.com:underloadjs/harness) where
    // ../../../tsconfig.json does not exist. Options mirror the noobscript
    // workspace root tsconfig.json so behavior is identical when the package is
    // developed inside the workspace.
    "compilerOptions": {
        "module": "ESNext",
        "target": "ESNext",
        "moduleResolution": "bundler",
        // `src/frontend/vite.config.ts` is loaded natively by Vite, which requires
        // explicit extensions; it imports `./vite-proxy.ts`. Both compiler modes
        // here are no-emit or declaration-only, so this is safe for the package.
        "allowImportingTsExtensions": true,
        "jsx": "react",
        "skipLibCheck": true,
        "allowJs": true,
        "experimentalDecorators": true,
        "declaration": true,
        "esModuleInterop": true,
        "strict": true,
        "outDir": "./dist",
        "lib": ["decorators", "dom", "es5", "scripthost", "es2015.collection"],
        "types": ["node", "vitest/globals"],
        // Tests import the package by name, never by relative path. Mirror the
        // package.json `exports.development` targets here (the entries Vite/Vitest
        // resolve) so the same specifier means the same FILE for editors, for
        // `tsc --noEmit`, and for the suite. `paths` is required because the
        // published `types` conditions deliberately stay on `dist/*.d.ts`: a
        // NodeNext consumer must get the emitted declarations (src/*.ts uses
        // extensionless relative specifiers that NodeNext rejects), so TS would
        // otherwise typecheck the suite against a stale build.
        // The bare name is the Node root (`src/index.ts`), exactly what
        // `exports["."]` publishes for a Node host; the library-only graph is
        // `src/harness.ts`, reached through it.
        "paths": {
            "@underload/harness": ["./src/index.ts"],
            "@underload/harness/server": ["./src/server/index.ts"],
            "@underload/harness/worker": ["./src/server/workers/lane-worker.ts"],
            "@underload/harness/io-worker": ["./src/server/workers/io-worker.ts"],
            "@underload/harness/frontend": ["./src/frontend/index.ts"],
            "@underload/harness/shared": ["./src/shared/index.ts"]
        }
    },
    "exclude": ["node_modules", "Temp", "**/*.test.ts", "**/dist/*", "**/lib/*"],
    "include": ["*.ts", "*.tsx", "**/*.ts", "**/*.tsx"]
}

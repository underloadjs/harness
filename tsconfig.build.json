{
    // Declaration-emit config for the npm build (`tsc -p tsconfig.build.json`).
    // Extends the package tsconfig but:
    // - emits ONLY .d.ts into dist/ (JS comes from `vite build`);
    // - restricts the root to src/ so only the public source tree is described;
    // - excludes tests, root-level tooling configs, and the playground, which are
    //   never part of the published package.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "emitDeclarationOnly": true,
        "declaration": true,
        "rootDir": "src",
        "outDir": "dist"
    },
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "**/*.test.tsx",
        "vite.config.ts",
        "vitest.config.ts",
        "playground",
        "server",
        "cli",
        "harnesses"
    ]
}

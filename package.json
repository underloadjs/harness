{
    "name": "@underload/harness",
    "version": "1.0.2",
    "description": "Standard underload harness. Ease to build and execute.",
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "browser": {
                "types": "./src/browser.ts",
                "default": "./src/browser.ts"
            },
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./server": {
            "types": "./src/server/index.ts",
            "default": "./src/server/index.ts"
        },
        "./worker": {
            "types": "./src/server/workers/lane-worker.ts",
            "default": "./src/server/workers/lane-worker.ts"
        },
        "./io-worker": {
            "types": "./src/server/workers/io-worker.ts",
            "default": "./src/server/workers/io-worker.ts"
        },
        "./frontend": {
            "types": "./src/frontend/index.ts",
            "default": "./src/frontend/index.ts"
        },
        "./shared": {
            "types": "./src/shared/index.ts",
            "default": "./src/shared/index.ts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.spec.ts",
        "!src/**/*.spec.tsx",
        "!src/**/__snapshots__/**",
        "!src/frontend/dist/**",
        "!src/**/node_modules/**",
        "!src/**/.vite/**"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/underloadjs/harness.git"
    },
    "homepage": "https://github.com/underloadjs/harness#readme",
    "bugs": {
        "url": "https://github.com/underloadjs/harness/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "npm run tools:manifest && npm run plugins:manifest && vite build && npm run build:types",
        "build:types": "node scripts/build-declarations.mjs",
        "build:frontend": "vite build --config src/frontend/vite.config.ts",
        "cli": "vite-node src/server/cli/index.ts",
        "dev:frontend": "vite --config src/frontend/vite.config.ts",
        "dev:server": "vite-node src/server/dev.ts",
        "preview:frontend": "vite preview --config src/frontend/vite.config.ts",
        "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run test:package:files && npm run test:package && npm run test:package:runtime && npm run test:package:tools",
        "test": "npm run tools:manifest:check && npm run plugins:manifest:check && vitest run",
        "test:contract": "node --test scripts/generate-harness-contract.test.mjs",
        "test:frontend": "vitest run --config src/frontend/vitest.config.ts",
        "test:package": "node scripts/check-package-types.mjs",
        "test:package:files": "node --test scripts/package-files.test.mjs",
        "test:package:runtime": "node scripts/check-package-runtime.mjs",
        "test:package:tools": "node scripts/check-package-tools.mjs",
        "plugins:manifest": "node scripts/generate-plugin-manifest.mjs",
        "plugins:manifest:check": "node scripts/generate-plugin-manifest.mjs --check",
        "tools:manifest": "vite-node scripts/generate-tool-manifest.mjs",
        "tools:manifest:check": "vite-node scripts/generate-tool-manifest.mjs --check",
        "typecheck": "npm run tools:manifest:check && npm run plugins:manifest:check && tsc --noEmit",
        "release": "vite-node ../../../scripts/publish-safe.ts"
    },
    "author": "NQQT",
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^25.9.1",
        "dompurify": "^3.4.15",
        "highlight.js": "11.12.0",
        "jsdom": "^29.0.2",
        "marked": "^18.0.12",
        "vite": "^8.0.8",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.4"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "typescript": "^6.0.0"
    }
}

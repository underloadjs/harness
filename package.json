{
    "name": "@underload/harness",
    "version": "1.0.2",
    "description": "Standard underload harness. Ease to build and execute.",
    "type": "module",
    "main": "./dist/underload-harness.mjs",
    "module": "./dist/underload-harness.mjs",
    "types": "./dist/harness.d.ts",
    "exports": {
        ".": {
            "types": "./dist/harness.d.ts",
            "import": "./dist/underload-harness.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/underloadjs/harness.git"
    },
    "homepage": "https://github.com/underloadjs/harness#readme",
    "bugs": {
        "url": "https://github.com/underloadjs/harness/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "build:playground": "vite build --config playground/vite.config.ts",
        "cli": "vite-node cli/index.ts",
        "dev:playground": "vite-node playground/dev.ts",
        "preview:playground": "vite preview --config playground/vite.config.ts",
        "serve": "vite-node cli/index.ts --serve",
        "server": "vite-node cli/index.ts --serve",
        "start": "vite-node playground/dev.ts",
        "prepublishOnly": "npm run typecheck && npm run test && npm run build",
        "test": "vitest run",
        "test:playground": "vitest run --config playground/vitest.config.ts",
        "typecheck": "tsc --noEmit",
        "release": "vite-node ../../../scripts/publish-safe.ts"
    },
    "author": "NQQT",
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^25.9.1",
        "dompurify": "^3.4.15",
        "dotenv": "^17.4.2",
        "highlight.js": "11.12.0",
        "jsdom": "^29.0.2",
        "marked": "^18.0.12",
        "typescript": "^6.0.0",
        "vite": "^8.0.8",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.4"
    }
}

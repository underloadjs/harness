# Copy this file to `.env` in the same directory (the package root):
#
#     packages/underload/harness/.env
#
# `yarn dev:server`, `yarn cli --serve`, and `yarn cli` load it
# automatically. Values already set in the shell/process environment win,
# including explicitly empty ones. Restart the process after editing.
#
# This example is tracked; `.env` itself is git-ignored. Never prefix a secret
# with `VITE_` â€” Vite exposes those to the browser.

# OpenAI-compatible provider used by live presets.
HARNESS_BASE_URL=http://localhost:5500/providers/private/v1
HARNESS_API_KEY=replace-with-provider-key
# Fallback for HARNESS_API_KEY when that is unset. Uncomment to use it.
# OPENAI_API_KEY=replace-with-provider-key
HARNESS_MODEL=merge/ds4-flash

# Optional web keys, read by the live presets (instruct, research, workspace,
# reviewer, planner, and the `flaky` example; the scripted `demo` stays offline).
#
# search   — Exa, Tavily or Linkup. With none of these keys the tool is simply
#            absent. With several keys the default provider follows the fixed
#            preference order exa > tavily > linkup; the others stay reachable
#            per call through the `provider` argument, which is only offered
#            when more than one key resolved.
# fetch    — needs NO key: the default provider is a direct native GET (text
#            only, 100 KiB). EXA_API_KEY / LINKUP_API_KEY additionally offer the
#            hosted crawler for that provider per call (`provider: "exa"`);
#            Tavily has no fetch provider, so it only enables search.
# download — always registered and needs no key at all (20 MiB per file, bytes
#            handed to the model as multimodal input).
#
# Keys are resolved once when a harness is constructed, so restart after editing.
EXA_API_KEY=your-exa-api-key
TAVILY_API_KEY=replace-with-tavily-key
LINKUP_API_KEY=replace-with-linkup-key

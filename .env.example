# Copy this file to `.env` in the same directory (the package root):
#
#     packages/underload/harness/.env
#
# `yarn dev:server`, `yarn cli --serve`, and `yarn cli` load it
# automatically. Values already set in the shell/process environment win,
# including explicitly empty ones. Restart the process after editing.
#
# This example is tracked; `.env` itself is git-ignored. Never prefix a secret
# with `VITE_` â€” Vite exposes those to the browser.

# OpenAI-compatible provider used by live presets.
HARNESS_BASE_URL=http://localhost:6660/providers/private/v1
HARNESS_API_KEY=replace-with-provider-key
# Fallback for HARNESS_API_KEY when that is unset. Uncomment to use it.
# OPENAI_API_KEY=replace-with-provider-key
HARNESS_MODEL=local/basalt

# Optional web keys, read by every shipped preset (general, instruct, research,
# workspace, reviewer, planner, debugger). There is no endpoint-free preset left:
# the scripted `demo` and the `flaky` example are deleted.
#
# search   — Exa, Tavily or Linkup. With none of these keys the tool is simply
#            absent. With several keys the default provider follows the fixed
#            preference order exa > tavily > linkup; the others stay reachable
#            per call through the `provider` argument, which is only offered
#            when more than one key resolved.
# fetch    — needs NO key: the default provider is a direct native GET (text
#            only, 100 KiB). EXA_API_KEY / LINKUP_API_KEY additionally offer the
#            hosted crawler for that provider per call (`provider: "exa"`);
#            Tavily has no fetch provider, so it only enables search.
# download — always registered and needs no key at all (20 MiB per file, bytes
#            handed to the model as multimodal input).
#
# Keys are resolved once when a harness is constructed, so restart after editing.
EXA_API_KEY=your-exa-api-key
TAVILY_API_KEY=replace-with-tavily-key
LINKUP_API_KEY=replace-with-linkup-key

# Provider time bounds (T6). Before these, NOTHING bounded the outbound provider
# call: a provider that accepted the TCP connection and then said nothing, or an SSE
# body that opened and stopped delivering, kept the thread `running` forever with a
# spinner and no explanation. Each value is a millisecond integer; 0 turns THAT bound
# off and restores the old wait. Defaults are deliberately generous, because cutting
# off a legitimately slow provider is worse than a stalled one failing a minute
# later — raise or disable them if your endpoint is slower than these:
#   HARNESS_PROVIDER_RESPONSE_HEAD_TIMEOUT_MS=300000   no response HEAD in 5 min -> terminal
#                                 A cold model load or a queue behind another generation can
#                                 legitimately take minutes, and some gateways flush headers
#                                 only when the first token is ready.
#   HARNESS_PROVIDER_FIRST_TOKEN_TIMEOUT_MS=300000   no first TOKEN in 5 min -> terminal
#                                 Sized for a large-context thinking model being silent
#                                 before its first reasoning or content delta.
#   HARNESS_PROVIDER_STREAM_CHUNK_TIMEOUT_MS=120000   stream SILENT for 2 min -> terminal
#                                 A streaming provider emits deltas sub-second apart, so a
#                                 two-minute gap means the upstream died silently.
# A provider that is simply NOT UP on the dialled port is recognised separately
# (`provider-connection`): it is retried twice (250 ms, 500 ms) and then fails in
# about a second with the dialled host:port in the message — no fifteen-minute
# backoff ladder. Not configurable here on purpose: it is a wrong-port condition, and
# the answer is the port, not a longer wait.
HARNESS_PROVIDER_RESPONSE_HEAD_TIMEOUT_MS=300000
HARNESS_PROVIDER_FIRST_TOKEN_TIMEOUT_MS=300000
HARNESS_PROVIDER_STREAM_CHUNK_TIMEOUT_MS=120000

# Server runtime: WHERE the work runs. Both shipped defaults are `inline` — everything on one
# event loop. The two worker modes are independent of each other, and each is a promise rather
# than a hint: a shape it cannot honour is a named error, never a quiet fallback to inline.
#
# HARNESS_THREAD_EXECUTION — `inline` (default) or `worker`. `worker` runs each live
#            conversation's turn — the agent loop AND every tool body — on its own lane
#            worker thread, so a CPU-bound tool cannot stall the server loop. In worker mode
#            nested conversation runs are REFUSED (the `delegate` and `threadFork` tools, and
#            the `context.run` a tool body holds), because a lane cannot centralise the child's
#            thread record and transcript; cross-thread work (threadRead / threadSend /
#            threadList) stays available because it routes to the canonical harness.
HARNESS_THREAD_EXECUTION=inline
#
# HARNESS_IO_EXECUTION — `inline` (default) or `worker`. `worker` moves the database
#            checkpoint and journal write side onto one IO worker thread per database root.
HARNESS_IO_EXECUTION=inline
#
# Lane tuning, all optional; the shipped defaults are shown here. A value outside its range
# aborts startup naming the variable (nothing is coerced):
#   HARNESS_WORKER_IDLE_MS=120000        reclaim a lane worker after this much idle time (0 = keep it)
#   HARNESS_MAX_LANE_WORKERS=16          concurrent lane workers, each owning a full harness replica
#   HARNESS_WORKER_HANDSHAKE_MS=60000    bound on worker import + build + capability report
#   HARNESS_WORKER_ENTRY / HARNESS_IO_WORKER_ENTRY   unset = the built bundles under dist/
